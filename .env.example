# Execution Backends (AUTO uses MSSQL/Pinecone if credentials are present, else LOCAL)
DATA_BACKEND=AUTO
SOP_BACKEND=AUTO

# LLM Provider: NVIDIA | OPENAI | DEEPSEEK | OLLAMA
Agent_llm=NVIDIA
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_MODEL=qwen2.5:7b


# Vector Store & Embeddings (optional when SOP_BACKEND=LOCAL)
PINECONE_API_KEY=
Embeddings_model=LOCAL
Local_Embedding_Model=BAAI/bge-m3

# Enterprise SQL Server (optional when DATA_BACKEND=LOCAL)
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_AGENT_USER=USR_FDE_RO
SQL_AGENT_PASSWORD=
SQL_ADMIN_USER=sa
SQL_ADMIN_PASSWORD=

# Optional Webhook for Escalation Alerts (Slack / Teams / PagerDuty)
ALERT_WEBHOOK_URL=

